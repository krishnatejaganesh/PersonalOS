# PersonalOS Configuration
# Copy this file to .env and fill in your values.
# Lines starting with # are comments — safe to leave them in.

# ─────────────────────────────────────────────
# REQUIRED — PersonalOS won't start without these
# ─────────────────────────────────────────────

# Your OpenRouter API key. Get one at https://openrouter.ai/keys
# OpenRouter gives you access to all major models on one key.
OPENROUTER_API_KEY=sk-or-your-key-here

# Your Telegram bot token. Create a bot via @BotFather on Telegram.
# Instructions: https://core.telegram.org/bots/tutorial
TELEGRAM_BOT_TOKEN=your-bot-token-here

# Your Telegram user ID. Message @userinfobot on Telegram to get it.
# PersonalOS only responds to this ID — keeps your agent private.
TELEGRAM_USER_ID=your-user-id-here


# ─────────────────────────────────────────────
# YOUR IDENTITY
# This is how PersonalOS knows who it's working for.
# ─────────────────────────────────────────────

# Your name (the agent addresses you by this)
YOUR_NAME=Alex

# Your timezone in IANA format
# Full list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TIMEZONE=Europe/London

# Primary language for agent responses
LANGUAGE=English

# Your location (city, country) — used for weather, local news, time-based greetings
LOCATION=London, UK


# ─────────────────────────────────────────────
# MODEL CONFIGURATION
# PersonalOS routes different tasks to different models automatically.
# Change these to swap models without touching any code.
# Full model list: https://openrouter.ai/models
# ─────────────────────────────────────────────

# Primary model — handles reasoning, planning, complex tasks
# Good defaults: anthropic/claude-sonnet-4-6 (balanced) | anthropic/claude-opus-4-6 (best quality)
PRIMARY_MODEL=anthropic/claude-sonnet-4-6

# Fast model — handles quick lookups, summaries, simple checks
# Good defaults: google/gemini-2.5-flash (cheapest) | anthropic/claude-haiku-4-5 (fast)
FAST_MODEL=google/gemini-2.5-flash

# Code model — used by the developer agent
# Good default: anthropic/claude-sonnet-4-6 | openai/gpt-4o (strong at code)
CODE_MODEL=anthropic/claude-sonnet-4-6

# Research model — used for deep research tasks
# Good default: anthropic/claude-opus-4-6 | perplexity/llama-3.1-sonar-large-128k-online
RESEARCH_MODEL=anthropic/claude-opus-4-6

# Maximum cost per task in USD (prevents runaway agent usage)
# Set to 0 for no limit. Recommended: 0.50 to 2.00
MAX_TASK_COST_USD=1.00


# ─────────────────────────────────────────────
# DAILY SCHEDULE
# When should PersonalOS run automated jobs?
# Format: HH:MM in your local timezone (set above)
# ─────────────────────────────────────────────

MORNING_BRIEFING_TIME=08:00
MIDDAY_CHECK_TIME=12:00
EVENING_WRAP_TIME=19:00

# Day of week for weekly review (0=Sunday, 1=Monday, ... 6=Saturday)
WEEKLY_REVIEW_DAY=0
WEEKLY_REVIEW_TIME=09:00

# Set to false to disable any automated job
ENABLE_MORNING_BRIEFING=true
ENABLE_MIDDAY_CHECK=true
ENABLE_EVENING_WRAP=true
ENABLE_WEEKLY_REVIEW=true


# ─────────────────────────────────────────────
# PERSONA
# Personas are pre-built configurations for common life situations.
# Options: solo-founder | freelancer | student | ecommerce | default
# You can customise any persona in the personas/ directory.
# ─────────────────────────────────────────────

PERSONA=default


# ─────────────────────────────────────────────
# INTEGRATIONS — optional but recommended
# Add these to connect PersonalOS to your real data.
# ─────────────────────────────────────────────

# Google Workspace (Gmail + Calendar + Drive)
# Get credentials at https://console.cloud.google.com
# Guide: docs/connecting-data.md#google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# GitHub (for developer agent)
# Create a token at https://github.com/settings/tokens
# Scopes needed: repo, read:user
GITHUB_TOKEN=
GITHUB_DEFAULT_REPO=

# Notion (for knowledge base storage)
NOTION_TOKEN=
NOTION_DATABASE_ID=

# Slack (for team notifications)
SLACK_BOT_TOKEN=
SLACK_DEFAULT_CHANNEL=

# Linear (for project/issue tracking)
LINEAR_API_KEY=

# Stripe (for revenue monitoring)
STRIPE_SECRET_KEY=

# Custom webhook (send PersonalOS output to any URL)
WEBHOOK_URL=


# ─────────────────────────────────────────────
# MEMORY AND STORAGE
# ─────────────────────────────────────────────

# PostgreSQL connection string
# Default works with docker-compose.yml — only change if using external DB
DATABASE_URL=postgresql://personalos:personalos@localhost:5432/personalos

# Redis connection (used for task queuing and rate limiting)
REDIS_URL=redis://localhost:6379

# How many days to keep conversation history (0 = forever)
HISTORY_RETENTION_DAYS=90

# Minimum score for a workflow to be reused in the self-improve loop (0.0–1.0)
WORKFLOW_REUSE_THRESHOLD=0.75


# ─────────────────────────────────────────────
# SECURITY
# ─────────────────────────────────────────────

# Secret key for signing internal API tokens — generate with:
# python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-string

# Set to true to require confirmation before any destructive action
# (deleting files, sending emails, merging PRs without review)
REQUIRE_CONFIRMATION=true

# Enable browser automation (Playwright)
# Set to false if you don't need it — reduces attack surface
ENABLE_BROWSER_AUTOMATION=true


# ─────────────────────────────────────────────
# DEVELOPER OPTIONS
# ─────────────────────────────────────────────

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Save full task logs to disk (useful for debugging)
SAVE_TASK_LOGS=true
TASK_LOG_DIR=./logs

# Dry run mode — agents plan but don't execute (good for testing)
DRY_RUN=false
